---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import EventCalendar from '../components/EventCalendar.jsx';
import UpcomingEvents from '../components/UpcomingEvents.jsx';
import { getFormattedEvents } from '../services/eventService';
import { isAdminRequest } from '../lib/adminAuth';
import CalendarSubscribe from '../components/CalendarSubscribe';

const pageTitle = 'Events | SUDATA';
const isAdmin = isAdminRequest(Astro.cookies);

// Determine if the user navigated here from an admin route
const referer = Astro.request.headers.get('referer');
let isComingFromAdmin = false;
if (referer) {
  try {
    isComingFromAdmin = new URL(referer, Astro.url.origin).pathname.startsWith('/admin');
  } catch (e) {
    isComingFromAdmin = false;
  }
}

const eventsData = JSON.parse(JSON.stringify(await getFormattedEvents()));
const initialEventId = Astro.url.searchParams.get('event') ?? '';
---


<Layout title={pageTitle}>
  <div class="min-h-screen bg-[#020617] text-[#94a3b8] pt-20 sm:pt-24 pb-12 sm:pb-16 px-4 sm:px-6">

    <!-- Header -->
    <div class="max-w-7xl mx-auto mb-8 sm:mb-12">
      <div class="text-center mb-6 sm:mb-8">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-3 sm:mb-4">
          <span class="text-[#00F0FF]" style="text-shadow: 0 0 20px #00F0FF, 0 0 40px #00F0FF;">
            Events
          </span>
        </h1>
        <p class="text-[#94a3b8] font-mono-tech text-base sm:text-lg tracking-wide mb-4 sm:mb-6">
          [ Temporal Data Stream ]
        </p>

        {isAdmin && isComingFromAdmin && (
          <div class="flex justify-center mb-8 reveal-on-scroll">
            <a 
              href="/admin/events" 
              class="px-6 py-2 border border-[#00F0FF]/40 text-[#00F0FF] text-xs font-mono-tech tracking-[0.2em] uppercase hover:bg-[#00F0FF]/10 hover:border-[#00F0FF] transition-all duration-300 flex items-center gap-2"
            >
               Back to Event Catalog 
            </a>
          </div>
        )}

        <!-- UPCOMING_EVENTS section -->
        <div class="reveal-on-scroll max-w-7xl mx-auto text-left">
          <UpcomingEvents events={eventsData} client:load />
        </div>
      </div>
    </div>

    <!-- Calendar Component -->
    <div id="events-calendar" class="max-w-7xl mx-auto scroll-mt-24">
      <!-- Subscribe bar: lives next to the calendar it acts on.
           relative z-50 lifts its stacking context above the calendar so the
           Subscribe dropdown isn't painted behind it. -->
      <div class="relative z-50 reveal-on-scroll flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
        <div class="text-left">
          <h2 class="text-lg sm:text-xl font-bold text-white font-mono-tech tracking-widest">Event Calendar</h2>
          <p class="text-sudata-grey font-mono-tech text-xs sm:text-sm mt-1 max-w-xl">
            Subscribe once and new SUDATA events sync to your calendar automatically — no re-importing.
          </p>
        </div>
        <div class="flex sm:justify-end">
          <CalendarSubscribe client:load />
        </div>
      </div>

      <EventCalendar events={eventsData} initialEventId={initialEventId} client:load />
    </div>

  </div>

  <!-- Floating "Go to calendar" button -->
  <button
    id="go-to-calendar"
    type="button"
    aria-label="Scroll to the events calendar"
    class="group fixed left-1/2 -translate-x-1/2 bottom-6 z-40 flex items-center gap-2 px-5 py-3 rounded-full
           font-mono-tech text-xs sm:text-sm font-bold tracking-wider text-[#020617]
           bg-[#00F0FF] shadow-[0_0_25px_rgba(0,240,255,0.5)]
           transition-all duration-300 hover:scale-105 active:scale-95"
  >
    <span>Go to calendar</span>
    <svg class="go-cal-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>
</Layout>

<script>
  const btn = document.getElementById('go-to-calendar');
  const calendar = document.getElementById('events-calendar');

  if (btn && calendar) {
    btn.addEventListener('click', () => {
      calendar.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // Hide the button once the calendar is in view
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          btn.classList.toggle('go-cal-hidden', entry.isIntersecting);
        });
      },
      { threshold: 0.15 },
    );
    observer.observe(calendar);
  }
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  #go-to-calendar {
    opacity: 1;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  #go-to-calendar.go-cal-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 1rem);
  }
  .go-cal-arrow {
    animation: go-cal-bounce 1.4s ease-in-out infinite;
  }
  @keyframes go-cal-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .go-cal-arrow {
      animation: none;
    }
  }
</style>
